# Copy this file to .env.local for local development, or set these same
# variables in your hosting platform's environment settings for production.
#
# IMPORTANT: generate fresh values for production — never reuse the ones
# below outside local development.

CMS_ADMIN_EMAIL=admin@soliibridge.com
CMS_ADMIN_PASSWORD=SoliiBridge2026!

# Random string used to sign admin session cookies. Generate a new one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=d47ca222e01fcda9f08e17521f085fa388a66f658e7e7e8e1fbe544c117641fd

# --- Form submissions ---------------------------------------------------
# Contact messages and job applications are always saved to the CMS inbox
# (/admin/inbox). They are also emailed to the address set in the CMS contact
# details (Admin > Contact > Email) when SMTP is set.
# Leave SMTP_HOST empty to skip email and use the inbox only.
SMTP_HOST=
SMTP_PORT=587
# "true" for implicit TLS (port 465); defaults to true only when SMTP_PORT is 465.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Optional. Defaults to "SoliiBridge Website" <SMTP_USER>.
MAIL_FROM=
